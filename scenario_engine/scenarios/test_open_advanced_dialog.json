{
  "schema_version": 1,
  "id": "open_daily_events_dialog",
  "name": "Mở Daily Events dialog",
  "description": "Gửi phím S và xác minh Daily Events trong cùng một Keyboard MCP tool call.",
  "status": "ready",
  "preconditions": [
    "Gemini Chat đã chọn window MU GameThuVN; tab sẽ đồng bộ PID và HWND đó sang Process MCP.",
    "teaching config có dynamicTexts.dialog.advanced.opened."
  ],
  "inputs": {},
  "limits": {
    "timeout_seconds": 2,
    "max_steps": 1,
    "max_tool_calls": 1
  },
  "steps": [
    {
      "id": "open_daily_events_dialog",
      "type": "mcp",
      "tool": "run_keyboard_action",
      "arguments": {
        "value": "s",
        "text_input_enabled": false,
        "delay_seconds": 0,
        "verify_event_type": "dialog.advanced.opened"
      },
      "save_result_as": "open_dialog_result",
      "assert": [
        "${open_dialog_result.ok} == true",
        "${open_dialog_result.action_ok} == true",
        "${open_dialog_result.verification.success} == true",
        "${open_dialog_result.verification.event_type} == 'dialog.advanced.opened'"
      ],
      "on_success": "complete",
      "on_failure": "failed"
    }
  ],
  "expected": {
    "success": {
      "action": "key s sent to the selected game window",
      "verification": "Daily Events text found within the default OCR timeout"
    },
    "failure": {
      "action_failed": "keyboard result action_ok is false",
      "verification_failed": "verification.success is false"
    }
  },
  "result": {
    "success_message": "Daily Events dialog đã mở và được OCR xác minh.",
    "failure_message": "Không thể mở hoặc xác minh Daily Events dialog."
  }
}
