{
  "schema_version": 1,
  "id": "select_game_and_press_key",
  "name": "Chọn process game và gửi một phím",
  "description": "Skill dùng chung cho các scenario cần điều khiển bàn phím trong game.",
  "inputs": {
    "process_name": {
      "type": "string",
      "required": true
    },
    "key": {
      "type": "string",
      "required": true
    }
  },
  "allowed_mcp_tools": [
    "select_game_process",
    "get_selected_process_info",
    "run_keyboard_action"
  ],
  "limits": {
    "timeout_seconds": 45,
    "max_tool_calls": 6,
    "max_retries_per_step": 1
  },
  "steps": [
    {
      "id": "select_process",
      "type": "mcp",
      "tool": "select_game_process",
      "arguments": {
        "process_name": "${inputs.process_name}"
      },
      "save_result_as": "process_selection",
      "on_success": "verify_process",
      "on_ambiguous": "ask_user_for_pid",
      "on_failure": "stop"
    },
    {
      "id": "ask_user_for_pid",
      "type": "ai",
      "prompt": "choose_game_process",
      "context": "${process_selection.candidates}",
      "rule": "Không tự chọn ngẫu nhiên khi có nhiều process.",
      "save_result_as": "user_process_choice",
      "on_success": "select_process_by_pid",
      "on_failure": "stop"
    },
    {
      "id": "select_process_by_pid",
      "type": "mcp",
      "tool": "select_game_process",
      "arguments": {
        "pid": "${user_process_choice.pid}"
      },
      "on_success": "verify_process",
      "on_failure": "stop"
    },
    {
      "id": "verify_process",
      "type": "mcp",
      "tool": "get_selected_process_info",
      "arguments": {},
      "save_result_as": "selected_process",
      "assert": [
        "${selected_process.ok} == true",
        "${selected_process.process.alive} == true",
        "${selected_process.process.windows.length} >= 1"
      ],
      "on_success": "press_key",
      "on_failure": "stop"
    },
    {
      "id": "press_key",
      "type": "mcp",
      "tool": "run_keyboard_action",
      "arguments": {
        "value": "${inputs.key}",
        "text_input_enabled": false,
        "delay_seconds": 0.2
      },
      "save_result_as": "keyboard_result",
      "on_success": "complete",
      "on_failure": "stop"
    }
  ]
}

